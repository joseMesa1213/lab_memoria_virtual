gt;&lt;font face=&quot;Courier New&quot;&gt;onAccess(0): splice al final&lt;/font&gt;&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="378.6" y="498.1" width="192.8" height="13.8" as="geometry"/></mxCell><mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;selectVictim(): popFront()     onLoad(f): pushBack(f)     onAccess(f): moveToBack(f)&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;std::list + vector&amp;lt;iterator&amp;gt;: mover un nodo al final es O(1) sin recorrer la lista.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Es un algoritmo de pila: con más marcos nunca produce más fallos.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="520.0" width="740.0" height="90.0" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;marco 0&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;A=1 0x010&lt;/font&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000.0" y="155.0" width="90.0" height="50.0" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;marco 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;A=0 0x002&lt;/font&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;r