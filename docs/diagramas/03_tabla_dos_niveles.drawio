35.0" y="430.0" as="sourcePoint"/><mxPoint x="495.0" y="470.0" as="targetPoint"/><Array as="points"><mxPoint x="1035.0" y="520.0"/><mxPoint x="495.0" y="520.0"/></Array></mxGeometry></mxCell><mxCell id="e37l" value="&lt;font style=&quot;font-size:10px&quot;&gt;fila 1 tiene S=1: su copia vigente está en swap → swap-in al fallar&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578.5" y="513.8" width="363.1" height="12.5" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;PageTableEntry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;frame  número de marco físico&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;V  valid: cargada en un marco&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;A  accessed: referenciada (CLOCK)&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;D  dirty: escrita desde que se cargó&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;S  swapped: tiene copia en swap&lt;/font&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="560.0" width="380.0" height="130.0" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Costo de memoria&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tabla plana: 2²⁰ PTE siempre&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dos niveles: 1024 punteros + 1024 PTE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;por cada región de 4 MB que se use&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PageTable::compact() libera tablas vacías&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450.0" y="560.0" width="330.0" height="130.0" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;PA = (frame &amp;lt;&amp;lt; offsetBits) | offset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;= (0 &amp;lt;&amp;lt; 12) | 0xABC&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;= 0x00000ABC&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="810.0" y="560.0" width="290.0" height="130.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
